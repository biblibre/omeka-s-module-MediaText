<?php
/**
 * @var MediaText\Api\Representation\MediatextDocumentRepresentation $mediatextDocument
 * @var Omeka\Api\Representation\MediaRepresentation $media
 */
?>

<div id="textual-representations" class="section">
    <?php if ($representations): ?>
        <?php foreach ($representations as $representation): ?>
            <div class="mediatext-representation row">
                <span>
                    <?= $representation->link($representation->title()) ?>
                    <?php if (!$representation->isPublic()): ?>
                        <span class="o-icon-private" aria-label="Private"></span>
                    <?php endif; ?>
                    <br>
                    <small>
                        <?= $this->escapeHtml($representation->typeLabel()) ?>
                        ·
                        <?= $this->escapeHtml($representation->formatLabel()) ?>
                        <?php if ($representation->isExtracted()): ?>
                            ·
                            <?= $this->escapeHtml($this->translate('Automatically extracted')) ?>
                        <?php endif; ?>
                    </small>
                </span>


                <ul class="actions">
                    <li><?= $representation->link('', 'edit', [
                        'class' => 'o-icon-edit',
                        'title' => $this->translate('Edit'),
                    ]); ?></li>
                    <li><?= $this->hyperlink('', '#', [
                        'data-sidebar-selector' => '#mediatext-sidebar',
                        'data-sidebar-content-url' => $representation->url('show-details'),
                        'class' => 'o-icon-more sidebar-content',
                        'title' => $this->translate('Details'),
                    ]); ?></li>
                </ul>
            </div>
        <?php endforeach; ?>

    <?php else: ?>
            <div class="no-resources">
                <p>
                    <?= $this->translate('This media has no textual representations.'); ?>
                </p>
            </div>
    <?php endif; ?>

    <div id="mediatext-sidebar" class="sidebar">
        <?php echo $this->hyperlink('', '#', [
            'class' => 'sidebar-close o-icon-close',
            'title' => $this->translate('Close'),
        ]); ?>
        <div class="sidebar-content"></div>
    </div>
</div>
