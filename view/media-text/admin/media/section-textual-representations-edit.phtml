<?php
/**
 * @var MediaText\Api\Representation\RepresentationRepresentation[] $representations
 * @var Omeka\Api\Representation\MediaRepresentation $media
 */

$this->headScript()->appendFile($this->assetUrl('js/media-manage-representations.js', 'MediaText'));
?>

<div id="textual-representations" class="section">
    <div id="mediatext-representation-list">
        <?php if ($representations): ?>
            <?php foreach ($representations as $i => $representation): ?>
                <div class="mediatext-representation row value">
                    <span class="sortable-handle"></span>

                    <span class="restore-value"><?= $this->escapeHtml($this->translate('Representation to be removed')) ?></span>

                    <span>
                        <?= $representation->link($representation->title()) ?>
                        <br>
                        <small>
                            <?= $this->escapeHtml($this->translate($representation->typeLabel())) ?>
                            ·
                            <?= $this->escapeHtml($this->translate($representation->formatLabel())) ?>
                            <?php if ($representation->isExtracted()): ?>
                                ·
                                <?= $this->escapeHtml($this->translate('Automatically extracted')) ?>
                            <?php endif; ?>
                        </small>
                    </span>

                    <input type="hidden" name="o:mediatext_representation[<?= $this->escapeHtml($i) ?>][o:id]" value="<?= $this->escapeHtml($representation->id()) ?>">

                    <ul class="actions">
                        <li>
                            <?php if ($representation->isPublic()): ?>
                                <?= $this->hyperlink('', '#', [
                                    'class' => 'o-icon-public',
                                    'title' => $this->translate('Make private'),
                                ]) ?>
                                <input type="hidden" name="o:mediatext_representation[<?= $this->escapeHtml($i) ?>][o:is_public]" value="1">
                            <?php else: ?>
                                <?= $this->hyperlink('', '#', [
                                    'class' => 'o-icon-private',
                                    'title' => $this->translate('Make public'),
                                ]) ?>
                                <input type="hidden" name="o:mediatext_representation[<?= $this->escapeHtml($i) ?>][o:is_public]" value="0">
                            <?php endif; ?>
                        </li>
                        <li><?= $representation->link('', 'edit', [
                            'class' => 'o-icon-edit',
                            'title' => $this->translate('Edit'),
                            'target' => '_blank',
                        ]); ?></li>
                        <li><?= $this->hyperlink('', '#', [
                            'class' => 'o-icon-delete remove-value',
                            'title' => $this->translate('Delete'),
                        ]); ?></li>
                        <li><?= $this->hyperlink('', '#', [
                            'class' => 'o-icon-undo restore-value',
                            'title' => $this->translate('Restore'),
                        ]); ?></li>
                    </ul>
                </div>
            <?php endforeach; ?>
        <?php else: ?>
            <div class="no-resources">
                <p>
                    <?= $this->translate('This media has no textual representations.'); ?>
                    <br>
                    <?= $this->translate('Start adding textual representations using the sidebar on the right'); ?>
                </p>
            </div>
        <?php endif; ?>
    </div>

    <div id="mediatext-sidebar" class="sidebar always-open">
        <?php echo $this->hyperlink('', '#', [
            'class' => 'sidebar-close o-icon-close',
            'title' => $this->translate('Close'),
        ]); ?>
        <h3><?= $this->translate('Extract textual representation from media') ?></h3>

        <?php if ($extractors): ?>
            <div class="field">
                <div class="field-meta">
                    <label><?= $this->escapeHtml($this->translate('Extract with')) ?></label>
                </div>
                <div class="inputs">
                    <?php foreach ($extractors as $extractor): ?>
                        <?php if ($extractor->isAvailable()): ?>
                            <label><input type="checkbox" name="mediatext_extractors[]" value="<?= $this->escapeHtml($extractor->getName()) ?>"><?= $this->escapeHtml($this->translate($extractor->getLabel())) ?></label>
                        <?php else: ?>
                            <label title="<?= $this->escapeHtml($this->translate('This extractor is not available')) ?>">
                                <input disabled type="checkbox"><del><?= $this->escapeHtml($this->translate($extractor->getLabel())) ?></del>
                                <?= $this->escapeHtml($this->translate('(not available)')) ?>
                        </label>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php else: ?>
            <p><?= $this->escapeHtml($this->translate('There are no available extractors for this media.')) ?></p>
        <?php endif; ?>

        <h3><?= $this->translate('Import textual representation') ?></h3>
        <?php foreach ($ingesters as $ingester): ?>
            <?php $ingesterName = $ingester->getName(); ?>
            <button type="button" class="option" data-ingester-name="<?= $this->escapeHtml($ingesterName) ?>"><?= $this->escapeHtml($ingester->getLabel()) ?></button>

            <template id="mediatext-representation-template-<?= $this->escapeHtml($ingesterName) ?>">
                <div class="mediatext-representation mediatext-representation-field-wrapper">
                    <div class="mediatext-representation-header">
                        <span class="sortable-handle"></span>
                        <h4><?= $this->translate($ingester->getLabel()); ?></h4>
                        <ul class="actions">
                            <li>
                                <?= $this->hyperlink('', '#', ['class' => 'o-icon-public', 'title' => $this->translate('Make private')]); ?>
                                <input type="hidden" name="o:mediatext_representation[__index__][o:is_public]" value="1">
                            </li>
                            <li>
                                <?php echo $this->hyperlink('', '#', ['class' => 'o-icon-delete mediatext-remove-new-representation-field', 'title' => $this->translate('Remove representation')]); ?>
                            </li>
                        </ul>
                    </div>

                    <?= $ingester->form($this); ?>

                    <input type="hidden" name="o:mediatext_representation[__index__][o:ingester]" value="<?= $this->escapeHtml($ingesterName); ?>">
                </div>
            </template>
        <?php endforeach; ?>
    </div>
</div>
